# Non-secret, deployment-specific settings for deploy.sh. Lives alongside
# secret.env in deploy-config/ so it survives repo clone/delete cycles.
# Edit this file to change deploy behavior without touching deploy.sh itself.
#
# Every key below must already exist in the repo's own .env.example —
# deploy.sh's apply_env_overrides() only ever overwrites an existing key,
# it never introduces a new one.

# Repo to clone and branch to deploy. Uses the dedicated
# github.com-fewcoco-core SSH host alias (~/.ssh/config on the server),
# routing through this repo's own read-only deploy key — GitHub deploy keys
# are per-repository, so the default `github.com` host (routed to
# etsy-shop-assistant's key) would not have access here.
REPO_URL=git@github.com-fewcoco-core:myjoyfulco/fewcoco-core.git
BRANCH=develop

# fewcoco_core_db lives as a second database inside v1's own Postgres
# container (etsy-shop-assistant-db-1), not a dedicated one — this stack's
# docker-compose.yml joins that container's compose network
# (etsy-shop-assistant_default) as external, where it already carries the
# alias "db". See bootstrap-db.sh for creating the database and role.
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

# Production is same-origin via nginx — no cross-origin browser calls to
# guard against.
CORS_ALLOWED_ORIGIN=

# Absolute base URL admin-created invites' registration_url is built
# against. Stable across the whole v1/v2 coexistence period.
REGISTRATION_URL_BASE=https://tools.myjoyfulco.com/etsy-shop-assistant

AI_PROVIDER=claude
ANTHROPIC_MODEL=claude-opus-4-1

# Admin login identifier — not a credential by itself, so it lives here
# rather than in secret.env. Same admin as v1's.
ADMIN_EMAIL=myjoyfulco@gmail.com

# /oauth/start and /oauth/redirect stay exclusively on v1 for the whole
# coexistence period (see doc/fewcoco-core.md's "Etsy OAuth during
# coexistence") — keep this false until decommission's Phase 3 cutover.
ETSY_OAUTH_ENABLED=false

# v2 answers real Etsy calls on request (dry-run off), but its publish
# scheduler stays off so only v1's scheduler publishes on a timer during
# coexistence — two independent schedulers reading two databases would
# otherwise race to publish the same copied etsy_publish_schedules rows.
ETSY_DRY_RUN=false
ETSY_PUBLISH_SCHEDULER_ENABLED=false

# Must not change — the currently-registered URI on Etsy's app settings
# page, unrelated to which service currently serves it. See
# doc/fewcoco-core.md's Phase 3 (OAuth cutover).
ETSY_REDIRECT_URI=https://tools.myjoyfulco.com/etsy-shop-assistant/oauth/redirect

LOG_LEVEL=INFO
LOG_TIMEZONE_OFFSET_HOURS=10

# bootstrap-db.sh only (not read by deploy.sh / apply_env_overrides — these
# keys don't exist in .env.example on purpose, they're not app config).
# Usernames/identifiers, not credentials — used via `docker exec` against
# v1's own db container.
DB_SUPERUSER=dbadmin
V1_DB_NAME=user_account
V1_DB_CONTAINER=etsy-shop-assistant-db-1

# Health-check target and polling behavior for deploy.sh's Step 6.
# /readyx (not /healthx) runs a real `SELECT 1` — proves the container
# actually reached fewcoco_core_db over the shared network, not just that
# the process is alive.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=5051
HEALTH_PATH=/readyx
# Higher than v1's 45s: create_app() runs run_migrations() and
# init_db_and_seed_admin() before the app ever starts serving.
HEALTH_TIMEOUT_SECONDS=60
HEALTH_POLL_INTERVAL=3
