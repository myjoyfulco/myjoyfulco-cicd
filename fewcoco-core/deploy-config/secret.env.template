# The app's actual secret/static .env values. NOT committed to git (see
# ~/deployment/.gitignore's `secret.env` line) — this file is a TEMPLATE,
# tracked so the shape of what's needed survives clone/delete cycles.
#
# To provision on the server:
#   cp secret.env.template secret.env
#   chmod 600 secret.env
#   <fill in the values below>
#
# Every key here must already exist in the repo's own .env.example —
# deploy.sh's apply_env_overrides() only ever overwrites an existing key.

# --- fewcoco_core_db (see bootstrap-db.sh) --------------------------------
# Freshly minted role, NOT a reuse of v1's dbadmin password. The role
# fewcoco_app already exists on production (created 2026-09-05, database
# since dropped 2026-09-06) — reuse its original generated password if you
# still have it, otherwise bootstrap-db.sh's ALTER ROLE step resets it to
# whatever you put here.
DB_NAME=fewcoco_core_db
DB_USER=fewcoco_app
DB_PASSWORD=

# v1's own DB_PASSWORD (the `dbadmin` role that owns user_account) —
# bootstrap-db.sh's step 4 needs this to read v1's tables for the one-time/
# incremental copy. Copy the value straight from
# ~/deployment/tools-myjoyfulco-com/deploy-config/secret.env's DB_PASSWORD.
# Not an app config key (not in .env.example) — deploy.sh's env merge
# ignores it, only bootstrap-db.sh reads it.
V1_DB_PASSWORD=

# --- JWT (flask-jwt-extended) ---------------------------------------------
# Fresh, generated for this deployment — NOT a reuse of v1's SECRET_KEY
# (different signing purpose entirely: v1 signs session cookies, this signs
# JWTs). e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=

# --- AI provider — shared accounts, same as v1 ----------------------------
# Copy straight from
# ~/deployment/tools-myjoyfulco-com/deploy-config/secret.env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=

# --- Etsy OAuth 2.0 (PKCE) — same Etsy app as v1 --------------------------
# Copy straight from
# ~/deployment/tools-myjoyfulco-com/deploy-config/secret.env. Not actually
# exercised while ETSY_OAUTH_ENABLED=false (deploy.env), but
# services/etsy/etsy_execute.py's live (non-dry-run) calls still need
# ETSY_CLIENT_ID/SECRET to authenticate outbound Etsy API requests.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
