# Non-secret, deployment-specific settings for deploy.sh. Lives alongside
# .env.secrets in deploy-config/ so it survives repo clone/delete cycles.
# Edit this file to change deploy behavior without touching deploy.sh itself.

# Repo to clone and branch to deploy.
REPO_URL=git@github.com:myjoyfulco/etsy-shop-assistant.git
BRANCH=develop

# Appended into the fresh clone's .env, overriding anything from
# .env.secrets with the same key (see deploy.sh Step 3).
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

# Health-check target and polling behavior for Step 6.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=5050
HEALTH_PATH=/etsy-shop-assistant/login
HEALTH_TIMEOUT_SECONDS=45
HEALTH_POLL_INTERVAL=3

# Admin login identifier — not a credential by itself (still needs the
# matching password), so it lives here rather than in secret.env.
ADMIN_EMAIL=myjoyfulco@gmail.com
