# Copy to /srv/data/deployments/fewcoco-web/properties/config.env and keep it
# off Git. These are non-secret host settings and public browser paths only.
BIND_IP=127.0.0.1
HOST_PORT=8180
IMAGE_ALLOWED_HOSTS=https://i.etsystatic.com

# Optional public overrides. Keys must already exist in .env.example and values
# must remain same-origin paths.
# VITE_API_BASE_URL=/etsy-shop-assistant/api/v2
# VITE_V1_BASE_URL=/etsy-shop-assistant/api
# VITE_OAUTH_BASE_URL=/etsy-shop-assistant/oauth
