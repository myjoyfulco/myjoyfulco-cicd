# Copy to /srv/data/deployments/fewcoco-web/deployment/secret.env, set mode
# 0600, and keep it off Git. These are deployment settings and public browser
# paths only. Never add usernames, passwords, tokens, API keys, or credentials.
BIND_IP=127.0.0.1
HOST_PORT=8180

# Optional public overrides. Keys must already exist in .env.example and values
# must remain same-origin paths.
# VITE_API_BASE_URL=/etsy-shop-assistant/api/v2
# VITE_V1_BASE_URL=/etsy-shop-assistant/api
# VITE_OAUTH_BASE_URL=/etsy-shop-assistant/oauth
